{
  "hosting": {
    "site": "slashatlas-studio",
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
          }
        ]
      },
      {
        "source": "**/*.@(woff2|webp|png|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.mp4",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "/data/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/ads.txt",
        "function": {
          "functionId": "slashatlasApi",
          "region": "europe-west1"
        }
      },
      {
        "source": "/og.jpg",
        "function": {
          "functionId": "slashatlasApi",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/**",
        "function": {
          "functionId": "slashatlasApi",
          "region": "europe-west1"
        }
      }
    ],
    "redirects": [
      {
        "source": "/tester/**",
        "destination": "/generer/",
        "type": 301
      },
      {
        "source": "/en/try/**",
        "destination": "/en/generate/",
        "type": 301
      },
      {
        "source": "/pack/",
        "destination": "/commandes/",
        "type": 301
      },
      {
        "source": "/pack",
        "destination": "/commandes/",
        "type": 301
      },
      {
        "source": "/en/pack/",
        "destination": "/en/commands/",
        "type": 301
      },
      {
        "source": "/en/pack",
        "destination": "/en/commands/",
        "type": 301
      },
      {
        "source": "/categorie/mode",
        "destination": "/categorie/mode-couture/",
        "type": 301
      },
      {
        "source": "/categorie/mode/",
        "destination": "/categorie/mode-couture/",
        "type": 301
      },
      {
        "source": "/en/category/mode",
        "destination": "/en/category/fashion-tailoring/",
        "type": 301
      },
      {
        "source": "/en/category/mode/",
        "destination": "/en/category/fashion-tailoring/",
        "type": 301
      },
      {
        "source": "/categorie/food",
        "destination": "/categorie/affiches-resto/",
        "type": 301
      },
      {
        "source": "/categorie/food/",
        "destination": "/categorie/affiches-resto/",
        "type": 301
      },
      {
        "source": "/en/category/food",
        "destination": "/en/category/restaurant-posters/",
        "type": 301
      },
      {
        "source": "/en/category/food/",
        "destination": "/en/category/restaurant-posters/",
        "type": 301
      },
      {
        "source": "/categorie/evenement",
        "destination": "/categorie/affiches-evenements/",
        "type": 301
      },
      {
        "source": "/categorie/evenement/",
        "destination": "/categorie/affiches-evenements/",
        "type": 301
      },
      {
        "source": "/en/category/evenement",
        "destination": "/en/category/event-posters/",
        "type": 301
      },
      {
        "source": "/en/category/evenement/",
        "destination": "/en/category/event-posters/",
        "type": 301
      },
      {
        "source": "/categorie/ecom",
        "destination": "/categorie/bannieres-ecommerce/",
        "type": 301
      },
      {
        "source": "/categorie/ecom/",
        "destination": "/categorie/bannieres-ecommerce/",
        "type": 301
      },
      {
        "source": "/en/category/ecom",
        "destination": "/en/category/ecommerce-banners/",
        "type": 301
      },
      {
        "source": "/en/category/ecom/",
        "destination": "/en/category/ecommerce-banners/",
        "type": 301
      },
      {
        "source": "/categorie/beaute",
        "destination": "/categorie/beaute-coiffure/",
        "type": 301
      },
      {
        "source": "/categorie/beaute/",
        "destination": "/categorie/beaute-coiffure/",
        "type": 301
      },
      {
        "source": "/en/category/beaute",
        "destination": "/en/category/beauty-hair/",
        "type": 301
      },
      {
        "source": "/en/category/beaute/",
        "destination": "/en/category/beauty-hair/",
        "type": 301
      },
      {
        "source": "/categorie/video",
        "destination": "/categorie/pubs-video/",
        "type": 301
      },
      {
        "source": "/categorie/video/",
        "destination": "/categorie/pubs-video/",
        "type": 301
      },
      {
        "source": "/en/category/video",
        "destination": "/en/category/video-ads/",
        "type": 301
      },
      {
        "source": "/en/category/video/",
        "destination": "/en/category/video-ads/",
        "type": 301
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "slashatlas",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
