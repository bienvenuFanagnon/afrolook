rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // HELPERS
    // ─────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Vérifie que l'utilisateur connecté a le rôle ADM
    function isAdmin() {
      return isAuth()
          && get(/databases/$(database)/documents/Users/$(uid())).data.role == 'ADM';
    }

    // Vérifie que l'utilisateur est participant du chat (sender ou receiver)
    function isChatParticipant(chatId) {
      let chat = get(/databases/$(database)/documents/Chats/$(chatId)).data;
      return chat.sender_id == uid() || chat.receiver_id == uid();
    }

    // Vérifie qu'un utilisateur n'est pas bloqué par l'autre
    function isNotBlocked(otherUserId) {
      let blockId = uid() + '_' + otherUserId;
      let reverseId = otherUserId + '_' + uid();
      return !exists(/databases/$(database)/documents/BlockedUsers/$(blockId))
          && !exists(/databases/$(database)/documents/BlockedUsers/$(reverseId));
    }

    // ─────────────────────────────────────────────────────────────
    // MESSAGES — seuls les participants d'un chat peuvent lire/écrire
    // ─────────────────────────────────────────────────────────────
    match /Messages/{messageId} {
      // Lecture : seul l'expéditeur ou le destinataire
      allow read: if isAuth()
          && (resource.data.send_by == uid()
              || resource.data.receiverBy == uid());

      // Création : l'expéditeur doit être l'utilisateur connecté
      allow create: if isAuth()
          && request.resource.data.send_by == uid()
          && request.resource.data.is_valide == true;

      // Mise à jour :
      // - Expéditeur : peut supprimer (is_valide=false) ou ajouter une réaction
      // - Destinataire : peut marquer comme lu (message_state)
      allow update: if isAuth() && (
        // Suppression par l'expéditeur
        (resource.data.send_by == uid()
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['is_valide', 'deleted_at', 'deleted_by', 'delete_scope']))
        ||
        // Marquage lu par le destinataire
        (resource.data.receiverBy == uid()
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['message_state', 'status']))
        ||
        // Réaction par les deux parties
        (request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['reaction']))
      );

      // Suppression physique interdite — uniquement logique via is_valide
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // CHATS — seuls les deux participants accèdent à leur conversation
    // ─────────────────────────────────────────────────────────────
    match /Chats/{chatId} {
      allow read: if isAuth()
          && (resource.data.sender_id == uid()
              || resource.data.receiver_id == uid());

      allow create: if isAuth()
          && (request.resource.data.sender_id == uid()
              || request.resource.data.receiver_id == uid());

      allow update: if isAuth()
          && (resource.data.sender_id == uid()
              || resource.data.receiver_id == uid());

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // USERS — lecture authentifiée, écriture seulement son propre profil
    // Les champs financiers sont mis à jour uniquement par Cloud Functions
    // ─────────────────────────────────────────────────────────────
    match /Users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && uid() == userId;
      allow update: if isAuth() && uid() == userId
          && !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(['votre_solde_principal', 'solde_ventes',
                       'solde_affiliation', 'solde_promo',
                       'canalCreationCredits', 'groupCreationCredits', 'lastPostAt']);
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // USER KEYS — clé publique lisible par tous (nécessaire pour E2E)
    // Écriture uniquement de sa propre clé
    // ─────────────────────────────────────────────────────────────
    match /UserKeys/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && uid() == userId;
    }

    // ─────────────────────────────────────────────────────────────
    // REPORTS — création uniquement par l'auteur du signalement
    // Lecture interdite côté client (admin uniquement via Cloud Functions)
    // ─────────────────────────────────────────────────────────────
    match /Reports/{reportId} {
      allow create: if isAuth()
          && request.resource.data.reportedBy == uid()
          && request.resource.data.keys().hasAll(['reportedBy', 'messageId', 'chatId', 'reason', 'createdAt']);
      allow read, update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // BLOCKED USERS — gestion des blocages
    // ─────────────────────────────────────────────────────────────
    match /BlockedUsers/{blockId} {
      // Lecture : seules les parties concernées
      allow read: if isAuth()
          && (resource.data.blockedBy == uid()
              || resource.data.blockedUser == uid());

      // Création : seul le bloqueur
      allow create: if isAuth()
          && request.resource.data.blockedBy == uid()
          && request.resource.data.keys().hasAll(['blockedBy', 'blockedUser', 'chatId', 'createdAt']);

      // Suppression (déblocage) : seul le bloqueur
      allow delete: if isAuth() && resource.data.blockedBy == uid();

      allow update: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // FRIENDS — lecture/écriture pour les deux parties
    // ─────────────────────────────────────────────────────────────
    match /Friends/{friendId} {
      allow read: if isAuth()
          && (resource.data.current_user_id == uid()
              || resource.data.friend_id == uid());
      allow create, update: if isAuth()
          && (request.resource.data.current_user_id == uid()
              || request.resource.data.friend_id == uid());
      allow delete: if isAuth()
          && (resource.data.current_user_id == uid()
              || resource.data.friend_id == uid());
    }

    // ─────────────────────────────────────────────────────────────
    // CONTENUS PAYANTS — lecture par tous, écriture par le propriétaire
    // ─────────────────────────────────────────────────────────────
    match /ContentPaies/{contentId} {
      allow read: if isAuth();
      allow create: if isAuth()
          && request.resource.data.ownerId == uid();
      allow update: if isAuth()
          && (resource.data.ownerId == uid() || isAdmin());
      allow delete: if isAuth()
          && (resource.data.ownerId == uid() || isAdmin());
    }

    // ─────────────────────────────────────────────────────────────
    // COMMENTAIRES CONTENUS PAYANTS — auteur peut modifier/supprimer, admin peut supprimer
    // ─────────────────────────────────────────────────────────────
    match /ContentComments/{commentId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth()
          && resource.data.userId == uid();
      allow delete: if isAuth()
          && (resource.data.userId == uid() || isAdmin());
    }

    // ─────────────────────────────────────────────────────────────
    // ACHATS — lecture acheteur/créateur, écritures réservées aux Cloud Functions
    // ─────────────────────────────────────────────────────────────
    match /ContentPaie_purchases/{purchaseId} {
      allow read: if isAuth()
          && (resource.data.userId == uid()
              || resource.data.ownerId == uid());
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // CODES PROMO — lecture par tous, écriture par le créateur
    // ─────────────────────────────────────────────────────────────
    match /PromoCodes/{codeId} {
      allow read: if isAuth();
      allow create: if isAuth()
          && request.resource.data.creatorId == uid();
      allow update, delete: if isAuth()
          && resource.data.creatorId == uid();
    }

    // ─────────────────────────────────────────────────────────────
    // LIENS D'AFFILIATION — lecture affilié/créateur, création libre
    // Les compteurs (totalSales, totalEarned) sont mis à jour par Cloud Functions
    // ─────────────────────────────────────────────────────────────
    match /AffiliateLinks/{linkId} {
      allow read: if isAuth()
          && (resource.data.affiliateId == uid()
              || resource.data.creatorId == uid());
      allow create: if isAuth()
          && request.resource.data.affiliateId == uid();
      // Seul le champ clicks peut être mis à jour par n'importe quel utilisateur authentifié
      allow update: if isAuth()
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['clicks']);
      allow delete: if isAuth()
          && (resource.data.affiliateId == uid()
              || resource.data.creatorId == uid());
    }

    // ─────────────────────────────────────────────────────────────
    // PSEUDO — lecture publique (vérification dispo lors de l'inscription)
    // Écriture uniquement par un utilisateur authentifié (profil créé)
    // ─────────────────────────────────────────────────────────────
    match /Pseudo/{pseudoId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ─────────────────────────────────────────────────────────────
    // POSTS
    // Les champs DÉFI (participations, votes) sont écrits uniquement par la
    // Cloud Function handleDefiAction : le client ne peut ni les créer ni les
    // modifier, ce qui empêche de participer ou voter sans payer.
    // ─────────────────────────────────────────────────────────────
    // La création d'un DÉFI (cagnotte débitée) et sa clôture (gains versés) passent
    // aussi uniquement par les Cloud Functions : defi_config et le type DEFI sont réservés.
    function defiServerKeys() {
      return ['defi_response_to_post_id', 'defi_participant_ids', 'defi_participant_count',
              'defi_votes', 'defi_voter_ids', 'defi_config', 'defi_winners', 'defi_settled_at', 'defi_revenue'];
    }

    match /Posts/{postId} {
      allow read: if isAuth();

      allow create: if isAuth()
          && (request.resource.data.user_id == uid() || isAdmin())
          && request.resource.data.get('type', '') != 'DEFI'
          && !request.resource.data.keys().hasAny(defiServerKeys());

      allow update: if isAuth()
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(defiServerKeys().concat(['user_id', 'monetized', 'paidLikes']))
          && !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['type'])
               && (resource.data.get('type', '') == 'DEFI' || request.resource.data.get('type', '') == 'DEFI'));

      allow delete: if isAuth() && (resource.data.user_id == uid() || isAdmin());
    }

    // Stickers personnels : créés et supprimés par leur propriétaire ; seule la légende est modifiable ensuite
    match /UserStickers/{stickerId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.ownerId == uid();
      allow update: if isAuth() && resource.data.ownerId == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['captions']);
      allow delete: if isAuth() && resource.data.ownerId == uid();
    }

    // Signalements de copies : créés par la Cloud Function reportStickerCopy, gérés par les admins
    match /StickerReports/{reportId} {
      allow read, write: if isAdmin();
    }

    // Quiz : le joueur lit sa progression et son historique ; tout est écrit par les Cloud Functions
    match /QuizProgress/{quizUid} {
      allow read: if isAuth() && request.auth.uid == quizUid;
    }
    match /QuizAttempts/{attemptId} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────
    // TOUTES LES AUTRES COLLECTIONS — requièrent auth minimale
    // ATTENTION : les règles Firestore s'additionnent (une seule règle qui
    // autorise suffit). Cette règle générale autorise donc aussi l'écriture
    // dans Users, Messages, etc. malgré leurs règles plus strictes ci-dessus.
    // Seuls les documents Posts en sont exclus pour l'instant.
    // ─────────────────────────────────────────────────────────────
    match /{collection}/{docId} {
      // Quiz : questions, parties et progression sont secrètes (lues seulement par les Cloud Functions ; le joueur lit
      // sa propre progression et son historique grâce aux règles dédiées plus haut)
      allow read: if isAuth()
          && !(collection in ['QuizLevels', 'QuizSessions', 'QuizAttempts', 'QuizProgress', 'QuizCountryShards']);
      // AppConfig (taux de change…) : écrit uniquement par les Cloud Functions
      // Stickers : catalogue, achats et compteurs écrits uniquement par les Cloud Functions
      // Follows : abonnements écrits uniquement par les Cloud Functions (followUser / unfollowUser)
      allow write: if isAuth() && collection != 'Posts' && collection != 'AppConfig'
          && !(collection in ['Stickers', 'StickerPacks', 'StickerOwnership', 'StickerUsage', 'StickerRejections', 'AdminActions', 'UserStickers', 'StickerReports', 'Follows', 'SocialClicks', 'WeeklyTopPosts', 'WeeklyTopCreators', 'WeeklyTopCommentators', 'WeeklyRewardLocks', 'AdRewards', 'AdSsvTx', 'AdRewardsWeek', 'AdRewardStats', 'QuizLevels', 'QuizSessions', 'QuizAttempts', 'QuizProgress', 'QuizWeekly', 'QuizCountryShards', 'QuizCountryBoard']);
    }

    // Taux de change : lisibles par tous (même avant la connexion), jamais écrits par l'app
    // Réglages publicitaires et récompenses : lisibles dès le démarrage de l'app, avant la connexion
    // (aucun secret : interrupteurs, fréquences, identifiants d'emplacements). Écriture : serveur seulement.
    match /AppConfig/ads {
      allow read: if true;
    }
    match /AppConfig/rewards {
      allow read: if true;
    }

    match /AppConfig/exchangeRates {
      allow read: if true;
    }

    // Sous-collections uniquement ({subCollection} impose au moins un segment de plus,
    // sinon {x=**} matcherait aussi le document lui-même et rouvrirait Posts).
    match /{collection}/{docId}/{subCollection}/{subPath=**} {
      allow read: if isAuth();
      // Récents des stickers : écrits par le serveur ; lecture réservée à leur propriétaire (ci-dessous)
      allow write: if isAuth() && subCollection != 'StickerRecents';
    }
  }
}
