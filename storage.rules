rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Photos de profil envoyées pendant l'inscription.
    // TEMPORAIRE (2026-09-25) : les versions de l'app publiées avant le correctif envoient
    // la photo AVANT de créer le compte (utilisateur non connecté). On autorise donc ici,
    // sans connexion : la création d'un NOUVEAU fichier image de 5 Mo max (pas de
    // remplacement, pas de suppression) et la lecture du fichier (getDownloadURL).
    // À retirer quand toutes les installations auront la version corrigée.
    match /user_profile/{fileName} {
      allow get: if true;
      allow create: if request.resource.size < 5 * 1024 * 1024
                    && (request.resource.contentType == null
                        || request.resource.contentType.matches('image/.*|application/octet-stream'));
    }
  }
}
