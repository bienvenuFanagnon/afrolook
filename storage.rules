rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Règle générale : tout fichier, sauf les dossiers ci-dessous qui ont leurs propres règles (propriétaire et
    // poids maximum) ou sont écrits uniquement par les Cloud Functions / l'administration.
    match /{folder}/{allPaths=**} {
      // Originaux des sons d'artistes : jamais lisibles depuis un téléphone (le serveur les lit ; extrait public de 30 s à part)
      allow read: if request.auth != null && !(folder in ['artist_sound_uploads', 'artist_sound_tmp']);
      allow write: if request.auth != null
          && !(folder in ['stickers', 'sticker_submissions', 'sticker_video_uploads', 'user_stickers', 'comment_media', 'test_builds', 'artist_sound_uploads', 'artist_sound_previews', 'artist_sound_tmp', 'ad_logos']);
    }

    // Logos de marque des annonceurs (Afrolook Ads) : chacun dépose le sien dans son dossier (image, 1 Mo au plus) ; affichés ensuite comme partenaires.
    match /ad_logos/{uid}/{file} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 1024 * 1024
                    && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{rootFile} {
      allow read, write: if request.auth != null;
    }

    // Sons d'artistes : l'artiste dépose son original (audio, 50 Mo maximum) dans son dossier ; il ne peut pas le relire ni
    // le réécrire, personne d'autre non plus : seul le serveur le lit (extrait public, Studio, lien signé pour l'admin).
    match /artist_sound_uploads/{uid}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 50 * 1024 * 1024
                    && request.resource.contentType.matches('audio/.*|application/octet-stream');
    }
    // Extraits publics de 30 s : écrits uniquement par le serveur
    match /artist_sound_previews/{file} {
      allow read: if request.auth != null;
    }

    // Stickers du catalogue : écrits uniquement par les Cloud Functions et l'administration (jamais par l'app)
    match /stickers/{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Dépôts de packs par les créateurs : le propriétaire écrit ses fichiers (600 Ko maximum, image)
    match /sticker_submissions/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 600 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Vidéos courtes envoyées pour devenir un sticker (3 Mo maximum) : converties puis supprimées par le serveur
    match /sticker_video_uploads/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 3 * 1024 * 1024
                    && request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Stickers personnels (« Mes stickers ») : lisibles par les connectés, écrits par leur propriétaire
    match /user_stickers/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 600 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Images de commentaire : 600 Ko maximum (300 Ko pour une image fixe, contrôlé aussi par le serveur)
    match /comment_media/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 600 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Versions de test de l'application : lues par lien, écrites uniquement par l'administration
    match /test_builds/{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Photos de profil envoyées pendant l'inscription.
    // TEMPORAIRE (2026-09-25) : les versions de l'app publiées avant le correctif envoient
    // la photo AVANT de créer le compte (utilisateur non connecté). On autorise donc ici,
    // sans connexion : la création d'un NOUVEAU fichier image de 5 Mo max (pas de
    // remplacement, pas de suppression) et la lecture du fichier (getDownloadURL).
    // À retirer quand toutes les installations auront la version corrigée.
    match /user_profile/{fileName} {
      allow get: if true;
      allow create: if request.resource.size < 5 * 1024 * 1024
                    && (request.resource.contentType == null
                        || request.resource.contentType.matches('image/.*|application/octet-stream'));
    }
  }
}
