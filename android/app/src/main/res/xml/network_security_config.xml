<?xml version="1.0" encoding="utf-8"?>
<!-- Le lecteur de musique relaie certains titres (lecture hors ligne chiffrée) par un petit serveur local de l'appareil :
     le trafic « en clair » n'est autorisé que vers l'appareil lui-même, jamais vers internet. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
