rules_version = '2';
// Aucun accès direct depuis le navigateur : les visiteurs et l'administration passent par les fonctions
// (pfWeb), qui vérifient tout côté serveur. Seul le SDK administrateur (fonctions) lit et écrit.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
