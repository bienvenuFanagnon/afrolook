# Uncomment this line to define a global platform for your project
platform :ios, '17.0'

# Appodeal (stack_appodeal_flutter 4.3.1) : sources des adaptateurs de réseaux (README du plugin, section iOS)
source 'https://github.com/appodeal/CocoaPods.git'
source 'https://github.com/bidon-io/CocoaPods-Specs.git'
source 'https://cdn.cocoapods.org'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Appodeal : adaptateurs des réseaux de médiation (depuis la 4.1.0 le plugin n'embarque que « Appodeal » et « IAB » : sans adaptateurs,
  # Appodeal ne sert aucune pub sur iPhone). Mêmes réseaux que sur Android (android/app/build.gradle), aux versions EXACTES du README du plugin.
  # Meta Audience Network passe par la médiation Appodeal (enchères) ; BidMachine est requis pour ses enchères.
  # Allégé le 07/11/2026 (taille de l'app : 376 Mo sur TestFlight) : Bigo (Asie), IronSource (double emploi avec Unity), Vungle (vidéo de jeux), Yandex (ex-URSS) retirés.
  # VOLONTAIREMENT ABSENTS : AdMob (AppodealGoogleAdMobAdapter 13.5 exige le SDK Google 13.5, alors que google_mobile_ads 6.0.0 impose
  # « Google-Mobile-Ads-SDK ~> 12.2.0 » : conflit « pod install » ; AdMob reste servi en direct par l'application), Mintegral, VK/MyTarget, Amazon.
  # Si « pod install » échoue (conflit de versions) : mettre ce bloc en commentaire, les bannières retombent sur AdMob direct comme avant.
  pod 'AppodealAppLovinAdapter', '13.6.4.0'
  pod 'AppodealBidMachineAdapter', '3.7.1.0'
  pod 'AppodealDTExchangeAdapter', '8.4.7.0'
  pod 'AppodealInMobiAdapter', '11.3.0.0'
  pod 'AppodealMetaAudienceNetworkAdapter', '6.21.1.0'
  pod 'AppodealUnityAdapter', '4.17.0.0'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end
  end

  # Fix: aosl.xcframework inclus par agora_rtc_engine ET agora_rtm.
  # CocoaPods génère des .xcfilelist listant les frameworks à embedder.
  # Si aosl apparaît deux fois → Xcode "Multiple commands produce".
  # On déduplique directement dans les xcfilelists après pod install.
  support_files = "#{installer.sandbox.root}/Target Support Files"
  Dir.glob("#{support_files}/**/*.xcfilelist").each do |xcfilelist|
    next unless File.exist?(xcfilelist)
    lines = File.readlines(xcfilelist, chomp: true)
    next unless lines.any? { |l| l.include?('aosl') }
    seen_aosl = false
    deduped = lines.reject do |line|
      if line.include?('aosl')
        dup = seen_aosl
        seen_aosl = true
        dup
      else
        false
      end
    end
    File.write(xcfilelist, deduped.join("\n") + "\n") if deduped.size < lines.size
  end

  # Allègement (09/11/2026, taille de l'application : environ 20 Mo en moins) : extensions d'Agora que l'application n'utilise PAS (l'application n'emploie d'Agora que
  # le live : audio, vidéo, partage d'écran et la beauté vidéo de base, qui vient d'AgoraClearVisionExtension : elle RESTE). Méthode de la documentation d'Agora
  # « App size optimization » (Flutter) : 1) lien « faible » (-weak_framework) pour que l'application démarre même si l'extension est absente, 2) l'extension n'est plus
  # copiée dans l'application (retirée des scripts et listes d'intégration générés par CocoaPods, comme la déduplication d'aosl ci-dessus).
  # PRUDENCE : rien n'est modifié si un seul lien « fort » vers l'une de ces extensions subsiste (l'application ne démarrerait plus) ; une erreur ici est ignorée
  # et n'arrête jamais le build. Si les lives plantent au lancement après cette modification : supprimer ce bloc. Mesure : taille de l'ipa (docs/TAILLE_APPLICATION.md).
  begin
    unused_agora = %w[
      AgoraLipSyncExtension AgoraSpatialAudioExtension AgoraFaceCaptureExtension AgoraVideoSegmentationExtension AgoraAudioBeautyExtension
      AgoraContentInspectExtension AgoraVideoAv1EncoderExtension AgoraVideoAv1DecoderExtension AgoraVideoQualityAnalyzerExtension
    ]
    xcconfigs = Dir.glob("#{support_files}/**/*.xcconfig")
    rewritten = {}
    xcconfigs.each do |path|
      original = File.read(path)
      text = original.dup
      unused_agora.each { |name| text = text.gsub("-framework \"#{name}\"", "-weak_framework \"#{name}\"") }
      rewritten[path] = text if text != original
    end
    strong_left = xcconfigs.any? do |path|
      text = rewritten[path] || File.read(path)
      unused_agora.any? { |name| text.include?("-framework \"#{name}\"") }
    end
    if strong_left
      puts "[allègement Agora] lien fort restant vers une extension : aucune modification"
    elsif rewritten.empty?
      puts "[allègement Agora] aucun lien trouvé : aucune modification"
    else
      rewritten.each { |path, text| File.write(path, text) }
      removed = 0
      Dir.glob("#{support_files}/Pods-Runner/*").each do |path|
        next unless File.file?(path) && (path.end_with?("-frameworks.sh") || path.end_with?(".xcfilelist"))
        lines = File.readlines(path)
        kept = lines.reject { |line| unused_agora.any? { |name| line.include?("#{name}.xcframework") || line.include?("#{name}.framework") } }
        if kept.size < lines.size
          File.write(path, kept.join)
          removed += lines.size - kept.size
        end
      end
      puts "[allègement Agora] #{rewritten.size} fichier(s) de liens et #{removed} ligne(s) d'intégration retirés"
    end
  rescue => e
    puts "[allègement Agora] ignoré : #{e.message}"
  end
end
